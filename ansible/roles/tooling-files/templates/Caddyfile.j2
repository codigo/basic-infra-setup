{% raw %}{
	auto_https off
	admin off
	email mau@codigo.sh
}

:80 {
	@codigo_and_maumercado host codigo.sh www.codigo.sh maumercado.com www.maumercado.com
	handle @codigo_and_maumercado {
		reverse_proxy mau-app-codigo:3000 {
			header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
			header_up X-Forwarded-Proto {http.request.header.X-Forwarded-Proto}
			header_up X-Forwarded-Host {http.request.host}
			header_up X-Forwarded-For {http.request.header.X-Forwarded-For}
			header_up CF-Ray {http.request.header.CF-Ray}
			header_up CF-Connecting-IP {http.request.header.CF-Connecting-IP}
		}
	}

	@pocketbase host pocketbase.codigo.sh pocketbase.maumercado.com
	handle @pocketbase {
		reverse_proxy pocketbase:8090 {
			header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
			header_up X-Forwarded-Proto {http.request.header.X-Forwarded-Proto}
			header_up X-Forwarded-Host {http.request.host}
			header_up X-Forwarded-For {http.request.header.X-Forwarded-For}
			header_up CF-Ray {http.request.header.CF-Ray}
			header_up CF-Connecting-IP {http.request.header.CF-Connecting-IP}
		}
	}

	@dozzle host dozzle.codigo.sh dozzle.maumercado.com
	handle @dozzle {
		reverse_proxy dozzle:8080 {
			header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
			header_up X-Forwarded-Proto {http.request.header.X-Forwarded-Proto}
			header_up X-Forwarded-Host {http.request.host}
			header_up X-Forwarded-For {http.request.header.X-Forwarded-For}
			header_up CF-Ray {http.request.header.CF-Ray}
			header_up CF-Connecting-IP {http.request.header.CF-Connecting-IP}
		}
	}

	@locker host locker.codigo.sh
	handle @locker {
		# Infisical's frontend sends POST /api/v1/auth/token (cookie-based
		# token refresh) without a Content-Type header. Fastify rejects the
		# request with "Unsupported Media Type: undefined" (415 → 500).
		# Default the request header to application/json when not set.
		@missing_ct {
			not header Content-Type *
			method POST PATCH PUT
		}
		request_header @missing_ct Content-Type "text/plain"

		reverse_proxy infisical:8080 {
			header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
			header_up X-Forwarded-Proto {http.request.header.X-Forwarded-Proto}
			header_up X-Forwarded-Host {http.request.host}
			header_up X-Forwarded-For {http.request.header.X-Forwarded-For}
			header_up CF-Ray {http.request.header.CF-Ray}
			header_up CF-Connecting-IP {http.request.header.CF-Connecting-IP}
		}
	}

	@grafana host grafana.codigo.sh
	handle @grafana {
		reverse_proxy grafana:3000 {
			header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
			header_up X-Forwarded-Proto {http.request.header.X-Forwarded-Proto}
			header_up X-Forwarded-Host {http.request.host}
			header_up X-Forwarded-For {http.request.header.X-Forwarded-For}
			header_up CF-Ray {http.request.header.CF-Ray}
			header_up CF-Connecting-IP {http.request.header.CF-Connecting-IP}
		}
	}

	# Catch-all for other requests
	handle {
		respond "Not Found" 404
	}
}
{% endraw %}
